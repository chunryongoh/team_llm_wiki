{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/team-llm-wiki/wiki-packet-manifest.schema.json",
  "title": "Team LLM Wiki Packet Manifest",
  "type": "object",
  "$defs": {
    "packet_relative_path": {
      "type": "string",
      "pattern": "^(?=.*\\S)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?!.*\\\\).+$"
    }
  },
  "required": [
    "id",
    "title",
    "date",
    "owner",
    "status",
    "task",
    "dataset",
    "split",
    "model",
    "claim_boundary",
    "claim_status",
    "summary",
    "raw_paths",
    "intended_wiki_targets"
  ],
  "anyOf": [
    {
      "required": ["packet_type"]
    },
    {
      "required": ["type"]
    }
  ],
  "allOf": [
    {
      "if": {
        "required": ["packet_type", "type"]
      },
      "then": {
        "oneOf": [
          {
            "properties": {
              "packet_type": {"const": "reference"},
              "type": {"const": "reference"}
            }
          },
          {
            "properties": {
              "packet_type": {"const": "meeting"},
              "type": {"const": "meeting"}
            }
          },
          {
            "properties": {
              "packet_type": {"const": "experiment"},
              "type": {"const": "experiment"}
            }
          },
          {
            "properties": {
              "packet_type": {"const": "feature"},
              "type": {"const": "feature"}
            }
          },
          {
            "properties": {
              "packet_type": {"const": "model"},
              "type": {"const": "model"}
            }
          },
          {
            "properties": {
              "packet_type": {"const": "performance"},
              "type": {"const": "performance"}
            }
          },
          {
            "properties": {
              "packet_type": {"const": "preprocessing"},
              "type": {"const": "preprocessing"}
            }
          },
          {
            "properties": {
              "packet_type": {"const": "augmentation"},
              "type": {"const": "augmentation"}
            }
          }
        ]
      }
    }
  ],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "type": {
      "description": "Legacy alias. Prefer packet_type for new manifests.",
      "enum": [
        "reference",
        "meeting",
        "experiment",
        "feature",
        "model",
        "performance",
        "preprocessing",
        "augmentation"
      ]
    },
    "packet_type": {
      "enum": [
        "reference",
        "meeting",
        "experiment",
        "feature",
        "model",
        "performance",
        "preprocessing",
        "augmentation"
      ]
    },
    "title": {
      "type": "string",
      "pattern": "\\S"
    },
    "date": {
      "type": "string"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "status": {
      "type": "string",
      "default": "draft"
    },
    "task": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "dataset": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "hash": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "split": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "group_key": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "fold_file": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?=.*\\S)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?!.*\\\\).+$"
        }
      }
    },
    "model": {
      "type": "object",
      "required": ["family"],
      "additionalProperties": false,
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "weights_in_repo": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "claim_status": {
      "enum": ["tentative", "supported", "disputed", "superseded"],
      "default": "tentative"
    },
    "summary": {
      "type": "string"
    },
    "raw_paths": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/packet_relative_path"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/packet_relative_path"
          }
        }
      ]
    },
    "intended_wiki_targets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metrics_to_verify": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "expected"],
        "anyOf": [
          {
            "required": ["actual"]
          },
          {
            "required": ["raw_path"]
          }
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "expected": {
            "type": "number"
          },
          "actual": {
            "type": "number"
          },
          "raw_path": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "tolerance": {
            "type": "number",
            "default": 0
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["status", "text"],
        "properties": {
          "status": {
            "enum": ["tentative", "supported", "disputed", "superseded"]
          },
          "text": {
            "type": "string"
          }
        }
      }
    }
  }
}
