{
  "pipeline": "wave43-waso",
  "approach": "MULTI-SCORER validated actigraphy (Cole-Kripke 1992, Sadeh 1994, Webster 1982 + rescoring rules, Oakley/Actiwatch threshold low/med/high, Sazonov 2004 logistic; ALL fixed published coefficients, NO fitting) on a per-minute ACTIVITY-COUNT PROXY (wPedo steps + mActivity non-STILL + within-minute wHr std) inside the reconstructed in-bed interval. Per-scorer SE/TST/SOL/WASO/#awak/mean+max awak/frag-idx/sleep-bouts/longest-bout/wake-bouts. SCORER-AGREEMENT + consensus-WASO (>=2/>=3/majority votes). FRAGMENTATION: movement-index, activity bursts, restlessness, HR-spike arousal density, early/mid/late-third WASO asymmetry. Structural SE=TST/TIB reconciliation vs each scorer.",
  "activity_count_proxy": "steps + 50*(mActivity!=STILL) + 8*hr_within_minute_std; missing->0",
  "scorers": {
    "cole_kripke": {
      "P": 1e-05,
      "weights": [
        404.0,
        598.0,
        326.0,
        441.0,
        1408.0,
        508.0,
        350.0
      ],
      "offsets": [
        -4,
        -3,
        -2,
        -1,
        0,
        1,
        2
      ],
      "rule": "sleep if D<1"
    },
    "sadeh": {
      "intercept": 7.601,
      "avg": -0.065,
      "nats": -1.08,
      "sd": -0.056,
      "lg": -0.703,
      "window_min": 11,
      "rule": "sleep if PS>0",
      "activity_cap": 300
    },
    "webster": {
      "P": 0.025,
      "weights": [
        0.15,
        0.15,
        0.15,
        0.08,
        0.21,
        0.12,
        0.13
      ],
      "offsets": [
        -4,
        -3,
        -2,
        -1,
        0,
        1,
        2
      ],
      "rule": "sleep if score<1 then apply 5 rescoring rules (4/10/15-min wake rules + short-bout flanking)"
    },
    "oakley_actiwatch": {
      "thresholds": {
        "low": 20.0,
        "med": 40.0,
        "high": 80.0
      },
      "weighted_count": "A0 + 0.2*(A-1+A+1) + 0.04*(A-2+A+2)",
      "rule": "wake if weighted>threshold"
    },
    "sazonov": {
      "intercept": 1.727,
      "coef": [
        -0.256,
        -0.154,
        -0.136,
        -0.14,
        -0.176,
        -0.131,
        -0.041
      ],
      "features": "descending order-stats of 7-min window",
      "rule": "sleep if logistic(z)>0.5"
    }
  },
